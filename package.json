{
  "name": "sportozen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit --incremental false",
    "check:contrast": "node scripts/check-contrast.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "test": "tsx --test --test-timeout=240000 --test-concurrency=3 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "tsx scripts/e2e-ci.ts",
    "auth:recover": "tsx --env-file-if-exists=.env.local scripts/recover-account.ts",
    "privacy:process": "tsx --env-file-if-exists=.env.local scripts/privacy-ops.ts process",
    "privacy:reconcile": "tsx --env-file-if-exists=.env.local scripts/privacy-ops.ts reconcile",
    "auth:check-config": "tsx --env-file-if-exists=.env.local scripts/check-security-config.ts",
    "db:migrate:plan": "tsx --env-file-if-exists=.env.local scripts/migrate.ts --plan",
    "test:pg": "tsx scripts/with-disposable-postgres.ts",
    "auth:email-worker": "tsx scripts/auth-email-worker.ts",
    "dispatch:worker": "tsx scripts/dispatch-worker.ts",
    "check:currency": "tsx scripts/check-currency-integrity.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "@electric-sql/pglite": "0.5.10",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.57.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
