# Copy to .env.local and configure. Never commit credentials.
# Review the result with: npm run auth:check-config -- --production  (prints variable names, never values).
# At least 32 random characters, e.g. `openssl rand -base64 48`. It also encrypts authenticator secrets and
# recovery codes: changing it after people enrol signs everyone out and makes their authenticators
# unreadable (each needs an owner/operator authenticator reset). Plan any change; see ACCOUNT_SECURITY.md.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
DATABASE_URL=
# Explicit local-only embedded PostgreSQL; production requires DATABASE_URL.
LOCAL_DATABASE_PATH=
# Enables fictional seed script only; never an authentication bypass.
ALLOW_DEV_SEED=
DEV_SEED_PASSWORD=

# Production start-up refuses invalid or unsafe values here (a match-everything range such as 0.0.0.0/0 is
# rejected); development prints warnings instead.
# Production behind a reverse proxy: comma-separated IPs/CIDRs of the proxy hops in front of the
# app. Setting it declares that ALL traffic arrives through those proxies, that they append the
# connecting client's address to the header below, and that the app port is not reachable any other
# way. Leave empty otherwise: forwarding headers are then ignored and all clients share one
# sign-in rate-limit bucket per endpoint (safe, but one attacker can throttle everyone).
TRUSTED_PROXIES=
TRUSTED_CLIENT_IP_HEADER=
# Production only: where private media (training video, photos) and the erasure evidence ledger live. Persistent, backed-up
# locations outside the application folder; the startup review warns when they are missing (media answers 503 until set).
PRIVATE_MEDIA_PATH=
ERASURE_LEDGER_PATH=
# Migrating a database that is not on this machine requires repeating its exact host:port/database.
MIGRATION_CONFIRM_TARGET=
# Optional: per-statement ceiling for migrations, milliseconds (default 300000).
MIGRATION_STATEMENT_TIMEOUT_MS=

# Two-factor authentication rollout (see ACCOUNT_SECURITY.md). Default off: MFA is available to
# everyone and required of nobody. Raise it in stages: warn (tell affected roles) then enforce
# (affected roles without an authenticator can sign in only to set one up).
MFA_ENFORCEMENT=
# Roles the mode applies to, comma-separated. Default when the mode is warn/enforce: the six staff roles
# OWNER,ADMIN,HEAD_COACH,COACH,FINANCE,NUTRITION_PRO (GUARDIAN and ADULT_PLAYER stay optional).
# This is the deployment-wide floor; each academy's owner can raise it in Settings but never lower it.
# Keep these values identical on every instance. Leave MFA_ENFORCEMENT empty/off until the owners have
# enrolled and the warning stage has run (ACCOUNT_SECURITY.md, "Phase 4").
MFA_REQUIRED_ROLES=
# Rollout order and rollback: ACCOUNT_SECURITY.md, "Safe MFA rollout". Set MFA_REQUIRED_ROLES only together with
# warn or enforce; with the mode off it is ignored (and reported).

# Optional "Continue with Google" (GOOGLE_SIGN_IN.md). Set BOTH or neither; it never links by email and only creates an unassigned account from the sign-up screen.
# Redirect URI to register with Google: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional transactional authentication email delivery. Choose ONE provider and set its variables together with EMAIL_FROM:
#   EMAIL_PROVIDER=resend    + RESEND_API_KEY
#   EMAIL_PROVIDER=zeptomail + ZEPTOMAIL_TOKEN   (Zoho ZeptoMail: the Mail Agent's "Send Mail token"; the
#                              "Zoho-enczapikey " prefix is optional). EMAIL_FROM must use a domain verified in that Mail Agent.
#   ZEPTOMAIL_API_URL only if your ZeptoMail account is not in the default data centre; it must be an https
#   api.zeptomail.* URL (default https://api.zeptomail.com/v1.1/email).
EMAIL_PROVIDER=
RESEND_API_KEY=
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_API_URL=
EMAIL_FROM=
# Sign-in and sign-up (email + password, Google) need NO mail provider. Only password-reset emails (and the optional
# emailed-code step) need the provider variables above. Keep
# `npm run auth:email-worker` running to deliver and retry them (AUTH_ONBOARDING.md).

# E-mail (ZeptoMail) and WhatsApp (Meta Cloud API) delivery for scheduled family messages. Leave a channel unset and
# it stays "not configured": its deliveries are recorded as NOT_CONFIGURED and nothing is sent. Secrets live here only.
# ZeptoMail: the Send Mail token and a verified sender (domain with SPF/DKIM). API URL only for another region (.in, .eu ...).
# SEND_TOKEN and FROM_ADDRESS may stay empty when the authentication e-mail setting above (ZEPTOMAIL_TOKEN, EMAIL_FROM) is set
# for the same ZeptoMail account: they then fall back to it. A value set here always wins.
ZEPTOMAIL_SEND_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=
# (ZEPTOMAIL_API_URL is shared with the authentication email setting above: same meaning, set it once.)
# WhatsApp: permanent access token, phone number id, and the APPROVED templates (JSON). Only these templates are ever sent.
# Key = the lower-case name of the academy message template, or "*" for messages that use none. params fill the template
# variables in order, from: recipientName, subject, body. Example:
# WHATSAPP_TEMPLATES={"*":{"template":"academy_update","language":"en","params":["recipientName","subject","body"]}}
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATES=
WHATSAPP_API_VERSION=
# Digits only, e.g. 91. Used for stored numbers written without a leading +.
WHATSAPP_DEFAULT_COUNTRY_CODE=

# Optional: a cookie name of its own for this server (letters, digits, hyphens). Use it when several Sportozen servers run on one machine,
# otherwise they share one browser cookie and sign each other out.
# SPORTOZEN_COOKIE_PREFIX=sz-bd-3330
